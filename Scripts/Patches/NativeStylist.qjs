const NativeStylistHairExpansion = function(_) { this.adapters=[]; this.stage1(_); this.stage2_open(_); return this.adapters; };
NativeStylistHairExpansion.stage2_open = _ =>
{
	const patchName = `${_} (Stage 2 Open)`;
	$$(patchName, 1, `Find the male hair table access in GetJobName`)
	const malePat = " A1" + (0x015fb30c).toHex(4) + " 8B 14 88";
	const femalePat = " A1" + (0x015fb318).toHex(4) + " 8B 14 88";
	const maleAddr = Exe.FindHex(malePat);
	const femaleAddr = Exe.FindHex(femalePat);
	if (maleAddr < 0 || femaleAddr < 0)
	{
		return;
	}
	$$(patchName, 2, `Build hook code for each site`)
	const hookSites = [
		{ addr: maleAddr, tableGlobal: 0x015fb30c },
		{ addr: femaleAddr, tableGlobal: 0x015fb318 }
	];
	const TABLE_LIMIT = 0x2B;
	hookSites.forEach( (site, i) =>
	{
		const retVir = Exe.Phy2Vir(site.addr + 8, CODE); 
		const hookCode =
			" A1" + site.tableGlobal.toHex(4)  
		+	" 83 F9" + TABLE_LIMIT.toHex(1)    
		+	" 7C 03"                            
		+	" 33 C9"                            
		+	" 41"                               
		+	" 8B 14 88"                         
		+	" E9 00 00 00 00"                   
		;
		const [hookPhy, hookVir] = Exe.Allocate(hookCode.byteCount(), 0x10);
		Exe.SetHex(hookPhy, hookCode);
		Exe.SetInt32(hookPhy + 17, retVir - (hookVir + 21));
		const addrVir = Exe.Phy2Vir(site.addr, CODE);
		Exe.SetHex(site.addr, " E9" + (hookVir - (addrVir + 5)).toHex(4));
		Exe.SetNOPs(site.addr + 5, 3); 
	});
};
NativeStylistHairExpansion.stage1 = patchName =>
{
	const _ = `${patchName} (Stage 1)`;
	$$(_, 1.1, `Find the format strings using a common part`)
	const addrs = Exe.FindTextN("\\\xB8\xD3\xB8\xAE\xC5\xEB\\%s\\%s", PHYSICAL, false, false);
	if (addrs.isEmpty())
		throw Error("Format string(s) missing");
	$$(_, 1.2, `Extract the string addresses`)
	const strAddrs = addrs.map(addr => (Exe.GetUint8(addr - 1) > 0 ? addr - 6 : addr));
	$$(_, 1.3, `Detect newer clients with Doram`)
	const doramOn = addrs[0] == strAddrs[0];
	$$(_, 1.4, `Find the format string for the palette (unless shared head palette is ON)`)
	let addr = -1;
	const fmtPrefix = "\xB8\xD3\xB8\xAE\\\xB8\xD3\xB8\xAE";
	if (Exe.Version <= 9) 
		addr = Exe.FindText(fmtPrefix + "%s%s_%d.pal", PHYSICAL); 
	if (addr < 0)
		addr = Exe.FindText(fmtPrefix + "%s_%s_%d.pal", PHYSICAL); 
	if (addr < 0)
		throw Error("Palette format string missing");
	$$(_, 1.5, `Add to the strAddrs`)
	strAddrs.push(addr);
	$$(_, 1.6, `Get the status of shared head palette patches`)
	const isPalShared = Warp.GetPatchState("HeadPalMF") || Warp.GetPatchState("HeadPalUnisex");
	$$(_, 1.7, `The limit is fixed - Allow65kHairs is the only patch bound to this function`)
	const maxHairs = 65535;
	CACHE.put('IH_Max', maxHairs);
	$$(_, 2, `Prep the lambda function for fixing comparisons`)
	const fixCmp = (addr) =>
	{
		if (maxHairs === 65535)
		{
			$$(_, 2.1, `For highest limit just enforce the conditional jump after the CMP`)
			Exe.SetJMP(addr + 3);
		}
		else if (maxHairs <= 0x7F)
		{
			$$(_, 2.2, `For 1 byte limits directly alter the limit value used`)
			Exe.SetInt16(addr + 2, maxHairs | 0x7C00); 
		}
		else
		{
			$$(_, 2.3, `For multi byte limits, extract the register used`)
			const reg = R32.List[Exe.GetUint8(addr + 1) & 0x7];
			$$(_, 2.4, `Construct the code for comparison`)
			code =
				CMP(reg, maxHairs) 
			+	JA(Filler(1))    
			+	JMP(Filler(2))   
			;
			$$(_, 2.5, `Prepare the arguments for auto-hook`)
			const args =
			{
				snap : 1,
				targets : {
					1 : Exe.Phy2Vir(addr + 5, CODE),
				    2 : Exe.GetTgtAddr(addr + 4, 1)
				}
			};
			$$(_, 2.6, `Add our code and jump to it from addr`)
			AutoHook(addr, code, args);
		}
		$$(_, 2.7, `Change the default value to 2 instead of 0D or 6`)
		let ins = Instr.FromAddr(addr + 5);
		ins.Immd = 2;
		Exe.SetHex(ins.Addr, ins);
	};
	$$(_, 3, `Prep the lambda function for table fixes`)
	const fixTbl = (addr) =>
	{
		$$(_, 3.1, `Extract the instruction`)
		let ins = Instr.FromAddr(addr);
		$$(_, 3.2, `Update the ModRM to not use the 4*reg part`)
		ins.MRM.update(null, null, ins.SIB.Base);
		$$(_, 3.3, `Change the SIB to 90h (quick hack to set a NOP at end)`)
		ins.SIB.Data = 0x90;
		$$(_, 3.4, `Replace the instruction`)
		Exe.SetHex(ins.Addr, ins);
	};
	let itoaVir = 0;
	let itoaBufVir = 0;
	const TABLE_SIZE = 0x2B;
	const MAX_STYLE = 65535;
	const fixTblCond = (addr) =>
	{
		if (itoaVir === 0)
		{
			const [bufPhy, bufVir] = Exe.Allocate(16, 0x10);
			Exe.SetHex(bufPhy, "00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00");
			itoaBufVir = bufVir;
			const itoaBody =
				" 60"
			+	" BF" + (bufVir + 15).toHex(4)
			+	" C6 07 00"
			+	" 8B C1"
			+	" B9 0A 00 00 00"
			+	" 33 D2"
			+	" F7 F1"
			+	" 80 C2 30"
			+	" 4F"
			+	" 88 17"
			+	" 85 C0"
			+	" 75 F2"
			+	" 89 7C 24 14"
			+	" 61"
			+	" C3"
			;
			const [itoaPhy, itoaVirAddr] = Exe.Allocate(itoaBody.byteCount(), 0x10);
			Exe.SetHex(itoaPhy, itoaBody);
			itoaVir = itoaVirAddr;
		}
		const retVir = Exe.Phy2Vir(addr + 5, CODE);
		const origBytes = Exe.GetHex(addr, 5);
		const origMov = Exe.GetHex(addr + 3, 2);
		const guard =
			" 81 F9" + MAX_STYLE.toHex(4)
		+	" 7E 03"
		+	" 33 C9"
		+	" 41"
		;
		const GUARD_LEN = 11;
		const hookCode =
			guard
		+	" 83 F9" + TABLE_SIZE.toHex(1)
		+	" 7D 0A"
		+	origBytes
		+	" E9 00 00 00 00"
		+	" E8 00 00 00 00"
		+	origMov
		+	" E9 00 00 00 00"
		;
		const [hookPhy, hookVir] = Exe.Allocate(hookCode.byteCount(), 0x10);
		Exe.SetHex(hookPhy, hookCode);
		Exe.SetInt32(hookPhy + GUARD_LEN + 11, retVir  - (hookVir + GUARD_LEN + 15));
		Exe.SetInt32(hookPhy + GUARD_LEN + 16, itoaVir - (hookVir + GUARD_LEN + 20));
		Exe.SetInt32(hookPhy + GUARD_LEN + 23, retVir  - (hookVir + GUARD_LEN + 27));
		const addrVir = Exe.Phy2Vir(addr, CODE);
		Exe.SetHex(addr, " E9" + (hookVir - (addrVir + 5)).toHex(4));
		NativeStylistHairExpansion.adapters.push({site:addrVir,va:hookVir,limit:MAX_STYLE});
	};
	strAddrs.forEach( (memAddr, idx) =>
	{
		const __ = `${_} [${idx}]`;
		const isLast = idx === strAddrs.length-1;
		const useCondTable = (Exe.BuildDate >= 20200101);
		if (!useCondTable && (!isLast || !isPalShared))
		{
			$$(__, 4.1, `Retrieve the string & get the position of the 2nd %s`)
			const fmt = Exe.GetText(memAddr);
			const pos = fmt.indexOf("%s", isLast ? 0 : fmt.indexOf("%s") + 1);
			$$(__, 4.2, `Change the %s to %u`)
			Exe.SetInt8(memAddr + pos + 1, 0x75);
		}
		$$(__, 4.3, `Find where the string is PUSHed`)
		const strVir = Exe.Phy2Vir(memAddr);
		const hookAddr = Exe.FindHex(PUSH(strVir));
		if (hookAddr < 0)
			throw Error("Format string not used");
		$$(__, 4.4, `Retrieve the stack register`)
		const sreg = ROC.StkReg; 
		$$(__, 4.5, `Find the start of the function`)
		let code, addr = -1, type; 
		if (Exe.BuildDate < 20111000)
		{
			code = '';
			if (ROC.HasFP)
			{
				code +=
					FP_START               
				;
			}
			else
			{
				code +=
					isLast
				?	INT3                   
				:	PUSH_R                 
				;
			}
			code +=
				MOV(R32, [sreg, ' 0?']) 
			;
			addr = Exe.FindLastHex(code, hookAddr, hookAddr - 0x200);
			type = 1;
		}
		if (addr < 0)
		{
			code =
				PUSH(-1)                
			+	PUSH(POS3WC)            
			+	MOV(EAX, FS, [0])       
			+	PUSH_EAX                
			;
			addr = Exe.FindLastHex(code, hookAddr, hookAddr - (ROC.FullVer == 14.29 ? 0x500 : 0x400));
			type = 2;
		}
		if (addr < 0)
			throw Error("Function start missing");
		$$(__, 4.6, `Save the address after the code`)
		const beginAddr = addr + code.byteCount();
		$$(__, 4.7, `Find the limiting comparison for hairstyle`)
		const prefix =
			" [01111.00] 05" 
		+	CMP(R32, WCp)    
		;
		const suffix =
			" [011111.0] 0?" 
		addr = Exe.FindHex(prefix + suffix, beginAddr, beginAddr + 0x50);
		if (addr < 0 && doramOn)
		{
			addr = Exe.FindHex(prefix + suffix, beginAddr + 0x100, beginAddr + 0x200);
		}
		if (addr < 0 && !isLast)
			throw Error("Limit checker missing");
		$$(__, 4.8, `Fix the CMP`)
		if (addr > 0)
			fixCmp(addr + 2);
		$$(__, 4.9, `Repeat when doram specific section is present (only for the spr & act)`)
		if (idx === 0 && doramOn)
		{
			addr = Exe.FindHex(prefix + suffix, addr + 5, addr + 0xB0);
			if (addr > 0)
				fixCmp(addr + 2);
		}
		$$(__, 4.10, `Find the table assignments (MOV or LEA regA, [regB*4 + regC])`)
		const isLEA = !isLast && strAddrs.length == 3 && Exe.BuildDate > 20110922;
		code = isLEA
			? LEA(R32, [4, R32, R32])
			: MOV(R32, [4, R32, R32])
			;
		$$(__, 4.11, `Filter out the false matches`)
		const addrs = Exe.FindHexN(code, beginAddr, hookAddr).filter(addr =>
		{
			const ins = Instr.FromAddr(addr);
			if (ins.BC_Disp > 0)
				return false;
			if (isLEA || strAddrs.length < 3)
				return true;
			const ins2 = ins.getNext();
			const ins3 = ins2.getNext();
			if (!isLast && ins2.Codes[0] === 0x52 && ins3.Codes[0] === 0x8B && ins3.SIB != undefined && ins3.SIB.Scale === 2) 
				return true;
			if (ins2.Codes[0] === 0x8B && ins2.BC_Disp > 0) 
			{
				if (ins3.Codes[0] === 0x52) 
					return true;
				if (ins3.Codes[0] === 0x8B && ins3.BC_Disp === 1 && ins3.SIB == undefined) 
					return true;
			}
			if (ins2.Codes[0] >= 0x50 && ins2.Codes[0] <= 0x57 && ins3.Codes[0] === 0x68) 
				return true;                                                              
			return false;
		});
		if (addrs.isEmpty())
			throw Error("Table fetchers not found");
		$$(__, 4.12, `Fix the tables`)
		addrs.forEach( useCondTable ? fixTblCond : fixTbl );
		if (useCondTable)
		{
		}
		else if (!isLast || !isPalShared)
		{
			if (isLast)
				Exe.BeginTag('SHP');
			$$(__, 5.1, `Calculate the base stack offset for retrieving the argument`)
			let offset;
			if (ROC.HasFP)
			{
				offset = 4; 
			}
			else if (type === 1) 
			{
				offset = 4 * 4; 
			}
			else 
			{
				offset = 4 * 3; 
				offset += Exe.GetInt8(beginAddr + 2); 
				code =
					PUSH_R.repeat(3)   
				+	MOV(EAX, [POS3WC]) 
				+	XOR(EAX, ESP)      
				+	PUSH_EAX           
				;
				addr = Exe.FindHex(code, beginAddr + 3, beginAddr + 0x20);
				if (addr < 0)
					throw Error("Register PUSHes missing");
				offset += 4 * 4; 
				code = Exe.GetUint8(addr - 1);
				if (code >= 0x50 && code <= 0x57) 
					offset += 4;
				if (Exe.BuildDate > 20111105)
				{
					addr = Exe.FindLastHex(PUSH_R.repeat(3) + LEA(R32, [sreg, WCp]), hookAddr, hookAddr - 0x20); 
					if (addr < 0)
						throw Error("Final Reg PUSHes missing");
					offset += 4 * 3; 
					code = Exe.GetUint8(addr - 1);
					if (code >= 0x50 && code <= 0x57) 
						offset += 4;
				}
				else
				{
					offset += 4 * 3; 
				}
			}
			$$(__, 5.2, `Construct the function argument required (which contains the hairstyle number or a pointer to it - in the case of spr/act)`)
			const arg = Exe.BuildDate < 20111108
				?  [sreg, offset + 4 * (isLast ? 1 : 2)]
				:  [sreg, offset + 4 * (isLast ? 2 : 5)]
				;
			offset = isLast ? 4 : 8;
			$$(__, 5.3, `Construct our code`)
			code =
				PUSH_EAX          
			+	ADD(ESP, offset)  
			+	MOV(EAX, arg)     
			+	(!isLast
			?
				MOV(EAX, [EAX])   
			:
				''
			)
			+	MOV([ESP], EAX)   
			+	SUB(ESP, offset)  
			+	POP_EAX           
			+	PUSH(strVir)      
			+	JMP(Filler(1))    
			;
			$$(__, 5.4, `Prepare the arguments for auto-hook`)
			const args =
			{
				targets : {
					1 : Exe.Phy2Vir(hookAddr + 5, CODE)
				}
			};
			$$(__, 5.5, `Add our code and jump to it from hookAddr`)
			AutoHook(hookAddr, code, args);
			if (isLast && doramOn)
			{
				$$(__, 6.1, `For doram palettes find the seperate format string`)
				const newStrAddr = Exe.FindText("%s\\" + fmtPrefix + "%s_%s_%d.pal", PHYSICAL);
				if (newStrAddr > 0)
				{
					$$(__, 6.2, `Change the second %s to %u`)
					Exe.SetInt8(newStrAddr + 4 + fmtPrefix.length, 0x75);
					$$(__, 6.3, `Find where it is PUSHed before the original format string PUSH`)
					const newStrPush = PUSH(Exe.Phy2Vir(newStrAddr));
					const newHookAddr = Exe.FindLastHex(newStrPush, hookAddr, beginAddr);
					if (newHookAddr < 0)
						throw Error("Second palette format string not PUSHed");
					$$(__, 6.4, `Construct the code for doram palette`)
					const code =
						PUSH_EAX          
					+	ADD(ESP, 8)       
					+	MOV(EAX, arg)     
					+	MOV([ESP], EAX)   
					+	SUB(ESP, 8)       
					+	POP_EAX           
					+	newStrPush        
					+	JMP(Filler(1))    
					;
					$$(__, 6.5, `Prepare the arguments for auto-hook`)
					const args =
					{
						targets : {
							1 : Exe.Phy2Vir(newHookAddr + 5, CODE)
						}
					};
					$$(__, 6.6, `Add our code and jump to it from newHookAddr`)
					AutoHook(newHookAddr, code, args);
				}
			}
			if (isLast)
				Exe.EndTag();
		}
	});
};


const NativeStylistTools = {
    bytes: function(hex) {
        const compact = (hex || '').replace(/\s/g, '')
        if (compact.length % 2 || /[^0-9a-f]/i.test(compact)) throw Error('Native Stylist: invalid binary data')
        const out = []
        for (let i=0; i<compact.length; i+=2) out.push(parseInt(compact.substr(i,2),16))
        return out
    },
    hex: function(bytes) { return bytes.map(b=>('0'+b.toString(16)).slice(-2)).join(' ') },
    u32: function(b,i) { return (b[i]|b[i+1]<<8|b[i+2]<<16|b[i+3]<<24)>>>0 },
    put32: function(b,i,v) { v>>>=0; b[i]=v&255; b[i+1]=v>>>8&255; b[i+2]=v>>>16&255; b[i+3]=v>>>24 },
    crc: function(bytes) {
        let crc=0xffffffff
        for (const b of bytes) {
            crc^=b
            for (let bit=0;bit<8;bit++) crc=crc&1?0xedb88320^(crc>>>1):crc>>>1
        }
        return (crc^0xffffffff)>>>0
    },
    read: function(va,n) {
        const raw=Exe.Vir2Phy(va)
        if(raw<0)throw Error('Native Stylist: unmapped native address '+va.toString(16))
        const data=this.bytes(Exe.GetHex(raw,n,true))
        if(data.length!==n)throw Error('Native Stylist: truncated native data')
        return {raw,data}
    },
    hair: function(site) {
        const b=this.read(site.va,5).data
        if(this.hex(b)==='8b 14 88 8b ca')return {stock:true}
        if(b[0]!==0xe9)throw Error('Native Stylist: conflicting hairstyle hook at '+site.va.toString(16))
        const va=(site.va+5+(this.u32(b,1)|0))>>>0
        const data=this.read(va,38).data
        if(this.hex(data.slice(0,2))!=='81 f9'||this.hex(data.slice(6,14))!=='7e 03 33 c9 41 83 f9 2b'||this.hex(data.slice(14,22))!=='7d 0a 8b 14 88 8b ca e9'||data[26]!==0xe8||this.hex(data.slice(31,34))!=='8b ca e9')
            throw Error('Native Stylist: unsupported hairstyle adapter at '+site.va.toString(16))
        if(((va+26+(this.u32(data,22)|0))>>>0)!==site.va+5||((va+38+(this.u32(data,34)|0))>>>0)!==site.va+5)
            throw Error('Native Stylist: hairstyle adapter return mismatch')
        return {stock:false,va,data}
    },
    check: function() {
        if(Exe.BuildDate!==20250716||Exe.ImageBase!==0x400000)
            throw Error('Native Stylist: this native address profile supports Ragexe 2025-07-16 x86')
        const pe=Exe.GetInt32(0x3c)
        const machine=this.bytes(Exe.GetHex(pe+4,2,true))
        if(this.hex(machine)!=='4c 01')throw Error('Native Stylist: x86 client required')
        const load=this.bytes(Exe.GetHex(pe+24+96+80,8,true))
        if(this.u32(load,0)&&this.u32(load,4)>=72){
            const seh=this.read(0x400000+this.u32(load,0)+64,8).data
            if(this.u32(seh,0)||this.u32(seh,4))throw Error('Native Stylist: this profile requires a host without a SafeSEH table')
        }
        for(const guard of NativeStylistProfile.guards) {
            const wanted=this.bytes(guard.hex),actual=this.read(guard.va,wanted.length).data
            if(this.hex(actual)!==this.hex(wanted))throw Error('Native Stylist: conflicting '+guard.name+' at 0x'+guard.va.toString(16))
        }
        const hair=NativeStylistProfile.hairs.map(site=>this.hair(site))
        if(hair.some(p=>p.stock)&&!hair.every(p=>p.stock))throw Error('Native Stylist: incomplete external hairstyle adapter')
        return hair.every(p=>p.stock)
    }
}

NativeStylist=function(_) {
    const p=NativeStylistProfile,t=NativeStylistTools
    $$(_,1,'Checking native hooks in the current patch session')
    const needHair=t.check()
    const file=new BinFile(Warp.Path+'Inputs/NativeStylist/native_stylist.dll','r')
    if(!file.Valid)throw Error('Native Stylist: missing Inputs/NativeStylist/native_stylist.dll')
    const bytes=t.bytes(file.ReadHex())
    file.Close()
    if(bytes.length!==p.fileSize||t.crc(bytes)!==p.crc32)throw Error('Native Stylist: payload does not match this QJS')
    const image=new Array(p.imageSize).fill(0)
    for(let i=0;i<p.headers;i++)image[i]=bytes[i]
    for(const section of p.sections) {
        if(section.raw+section.size>bytes.length||section.rva+section.size>image.length)throw Error('Native Stylist: invalid payload section')
        for(let i=0;i<section.size;i++)image[section.rva+i]=bytes[section.raw+i]
    }
    for(const at of p.relocations) {
        if(at<p.headers||at+4>image.length)throw Error('Native Stylist: invalid payload relocation')
        const v=t.u32(image,at)
        if(v<p.linkedBase||v>=p.linkedBase+p.imageSize)throw Error('Native Stylist: relocation outside payload')
    }
    $$(_,2,'Preparing hairstyle support')
    const generated=needHair?NativeStylistHairExpansion.call(NativeStylistHairExpansion,_):null
    if(generated&&generated.length!==p.hairs.length)throw Error('Native Stylist: incomplete generated hairstyle adapters')
    const limits=[65535,65535]
    for(const site of p.hairs) {
        let cap
        if(generated){
            const found=generated.filter(h=>h.site===site.va)
            if(found.length!==1)throw Error('Native Stylist: generated hairstyle site mismatch')
            const h=found[0],branch=t.read(site.va,5).data
            if(branch[0]!==0xe9||((site.va+5+(t.u32(branch,1)|0))>>>0)!==h.va||Exe.Vir2Phy(h.va)<0)
                throw Error('Native Stylist: generated hairstyle target mismatch')
            cap=h.limit
        }else{
            const h=t.hair(site)
            if(h.stock)throw Error('Native Stylist: hairstyle adapter was not installed')
            cap=t.u32(h.data,2)
        }
        if(!cap||cap>65535)throw Error('Native Stylist: invalid hairstyle limit')
        const domain=site.doram?1:0
        limits[domain]=Math.min(limits[domain],cap)
    }
    $$(_,3,'Embedding the relocatable Stylist module')
    const allocation=Exe.Allocate(p.imageSize,0x1000),raw=allocation[0],va=allocation[1]
    if(raw<0||va<0x400000||va+p.imageSize>=0x80000000)throw Error('Native Stylist: invalid allocation')
    for(const at of p.relocations)t.put32(image,at,t.u32(image,at)+va-p.linkedBase)
    t.put32(image,p.exports.NativeHairLimits,limits[0])
    t.put32(image,p.exports.NativeHairLimits+4,limits[1])
    for(let at=0;at<image.length;at+=16384)Exe.SetHex(raw+at,t.hex(image.slice(at,at+16384)))
    $$(_,4,'Installing Stylist hooks without restoring previous patch data')
    for(const hook of p.hooks) {
        const patch=[],target=va+p.exports[hook.symbol]
        if(hook.opcode) {
            patch.push(hook.opcode,0,0,0,0)
            t.put32(patch,1,target-hook.va-5)
            while(patch.length<hook.size)patch.push(0x90)
        } else t.put32(patch,0,target)
        Exe.SetHex(t.read(hook.va,hook.size).raw,t.hex(patch))
    }
    const pe=Exe.GetInt32(0x3c),flags=pe+24+70
    const before=t.bytes(Exe.GetHex(flags,2,true))
    before[0]&=0xbf
    Exe.SetHex(flags,t.hex(before))
    Exe.SetHex(pe+24+64,'00 00 00 00')
    return true
}
NativeStylist.validate=function(){return Exe.BuildDate===20250716&&Exe.ImageBase===0x400000}
